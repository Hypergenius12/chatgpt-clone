# GEMINI_API_KEY: Primary key for AI responses and streaming.
GEMINI_API_KEY="YOUR_PRIMARY_GEMINI_API_KEY"

# GEMINI_FALLBACK_API_KEY: Automatic fallback key in case the primary key hits quota or rate limits.
GEMINI_FALLBACK_API_KEY="YOUR_FALLBACK_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
